# Backend API host (no trailing slash). Dev: proxy /api → this URL.
# Local: http://localhost:3011
# Vercel production (required for live admin — must redeploy after change):
# VITE_API_URL=https://bolobill.onrender.com
VITE_API_URL=http://localhost:3011

# Public bill links in WhatsApp (admin app URL, no trailing slash)
# VITE_PUBLIC_BILL_BASE_URL=https://bolobill.useaifast.com
VITE_PUBLIC_BILL_BASE_URL=http://localhost:3000

# Landing & request-access page (optional)
# Contact email is in admin/src/config/contact.ts
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
