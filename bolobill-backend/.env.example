NODE_ENV=development
PORT=3011
BASE_URL=http://localhost:3011
# Production (Render): https://bolobill.onrender.com
PUBLIC_BILL_BASE_URL=http://localhost:3000
# Production (admin): https://bolobill.useaifast.com
MONGODB_URI=mongodb://127.0.0.1:27017/bolobill
# Production: mongodb+srv://...@host.mongodb.net/bolobill?retryWrites=true&w=majority
JWT_SECRET=change_this_super_secret
OPENAI_API_KEY=your_openai_api_key_here
# Set to true to skip OpenAI for menu import UI testing (returns sample products)
# MENU_IMPORT_MOCK=true
ALLOW_X_USER_ID_AUTH=false
# Optional: lock menu/OOS photo AI import behind a demo PIN (header X-BoloBill-Ai-Demo-Pin)
# AI_VISION_DEMO_PIN=5870
